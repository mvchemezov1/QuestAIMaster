; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; Уникальный идентификатор приложения (не менять после релиза)
AppId={{A1B2C3D4-E5F6-7890-ABCD-1234567890AB}
; Название и версия
AppName=Quest AI
AppVersion=1.0
AppPublisher=Your Name
; Папка установки по умолчанию
DefaultDirName={autopf}\Quest AI
; Имя файла установщика
OutputBaseFilename=QuestAI_Setup
; Сжатие
Compression=lzma2
SolidCompression=yes
; Требовать права администратора (если ставим в Program Files)
PrivilegesRequired=admin
; Иконка установщика (если есть .ico файл)
; SetupIconFile=quest_ai.ico
; Стиль мастера
WizardStyle=modern

[Languages]
; Русский язык
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Tasks]
; Задача: создать ярлык на рабочем столе
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Копируем наш EXE-файл из папки dist в папку установки
Source: "QuestAI.exe"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
; Ярлык в меню Пуск
Name: "{autoprograms}\Quest AI"; Filename: "{app}\QuestAI.exe"
; Ярлык на рабочем столе (создаётся, если выбрана задача)
Name: "{autodesktop}\Quest AI"; Filename: "{app}\QuestAI.exe"; Tasks: desktopicon

[Run]
; Предложить запустить приложение после установки
Filename: "{app}\QuestAI.exe"; Description: "{cm:LaunchProgram,Quest AI}"; Flags: nowait postinstall skipifsilent